<header style="max-width:600px; margin:0 auto; background-color:#ffffff; padding:20px 24px; border-bottom:1px solid #eee; font-family: Arial, Helvetica, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
    <tr>
      <!-- LEFT: LOGO -->
      <td align="left" style="vertical-align:middle;">
        <img 
          src="https://app.wittytalk.ai/_next/image?url=%2Fwittytalk-logo.png&w=256&q=75" 
          alt="WittyTalk Logo" 
          height="36"
          style="display:block; border:0; height:36px; width:auto;"
        />
      </td>
      <!-- RIGHT: User profile image when present (no Go to App button) -->
      <td align="right" style="vertical-align:middle; width:1%;">
        {{#if profileImageUrl}}
        <img 
          src="{{profileImageUrl}}" 
          alt="Profile" 
          width="40"
          height="40"
          style="display:block; border:0; width:40px; height:40px; border-radius:50%; object-fit:cover;"
        />
        {{/if}}
      </td>
    </tr>
  </table>
</header>
