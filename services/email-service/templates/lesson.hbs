{{> header}}

<!-- Lesson email: clear background, labeled sections, distinct note vs feedback styling -->
<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px; margin:0 auto; font-family: Arial, Helvetica, sans-serif;">
  <tr>
    <td style="padding:40px 28px; background:#ffffff;">
      <!-- Greeting -->
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:24px;">
        <tr>
          <td style="color:#1a1a1a; font-size:16px; line-height:1.5;">Hey{{#if name}} {{name}}{{/if}},</td>
        </tr>
      </table>

      <!-- Intro: what is happening -->
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:28px;">
        <tr>
          <td style="color:#4a5568; font-size:15px; line-height:1.6;">We prepared your next lesson for you. Below you’ll find the lesson details, a short description, and a link to start when you’re ready.</td>
        </tr>
      </table>

      <!-- Label: Lesson -->
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:6px;">
        <tr>
          <td style="color:#718096; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em;">Lesson</td>
        </tr>
      </table>
      <!-- Lesson name -->
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:24px;">
        <tr>
          <td style="color:#1a1a1a; font-size:20px; font-weight:700; line-height:1.3; letter-spacing:-0.02em;">{{lessonName}}</td>
        </tr>
      </table>

      <!-- Optional note: distinct style with label and left-accent -->
      {{#if note}}
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:24px;">
        <tr>
          <td style="padding-left:16px; border-left:4px solid #6a5acd;">
            <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
              <tr>
                <td style="color:#718096; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; padding-bottom:6px;">Note</td>
              </tr>
              <tr>
                <td style="color:#2d3748; font-size:15px; line-height:1.5;">{{note}}</td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
      {{/if}}

      <!-- Label: About this lesson -->
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:8px;">
        <tr>
          <td style="color:#718096; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em;">About this lesson</td>
        </tr>
      </table>
      <!-- Description card -->
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:28px; border-radius:10px; background:#f8f9fb; border:1px solid #e8eaed;">
        <tr>
          <td style="padding:20px; color:#2d3748; font-size:15px; line-height:1.6;">{{{description}}}</td>
        </tr>
      </table>

      <!-- CTA: flat purple button -->
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:36px;">
        <tr>
          <td align="center">
            <a href="{{lessonUrl}}" target="_blank" style="display:inline-block; padding:14px 28px; border-radius:10px; font-size:16px; font-weight:600; text-decoration:none; background:#6a5acd; color:#ffffff;">Continue to latest lesson</a>
          </td>
        </tr>
      </table>

      <!-- Past feedback: section label and list style (not cards) -->
      {{#if pastFeedback}}
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:10px;">
        <tr>
          <td style="color:#718096; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em;">Past feedback from your lessons</td>
        </tr>
      </table>
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:8px;">
        <tr>
          <td style="color:#4a5568; font-size:13px; line-height:1.4;">Here’s feedback from previous sessions to keep in mind:</td>
        </tr>
      </table>
      {{#each pastFeedback}}
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:12px;">
        <tr>
          <td style="padding:12px 16px; background:#fafbfc; border-radius:8px; border:1px solid #eef0f3;">
            <table cellpadding="0" cellspacing="0" role="presentation">
              <tr>
                <td style="color:#6a5acd; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.03em; padding-bottom:4px;">Feedback</td>
              </tr>
              <tr>
                <td style="color:#2d3748; font-size:14px; line-height:1.5;">{{{this}}}</td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
      {{/each}}
      {{/if}}
    </td>
  </tr>
</table>

{{> footer}}
